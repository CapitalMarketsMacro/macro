{
  "name": "macro-grid-format",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/macro-grid-format/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/macro-grid-format",
        "main": "libs/macro-grid-format/src/index.ts",
        "tsConfig": "libs/macro-grid-format/tsconfig.lib.json",
        "assets": ["libs/macro-grid-format/*.md"]
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
