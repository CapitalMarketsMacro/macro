{
  "name": "macro-workspace",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/macro-workspace/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/macro-workspace",
        "browser": "apps/macro-workspace/src/main.ts",
        "polyfills": [],
        "tsConfig": "apps/macro-workspace/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/macro-workspace/public"
          }
        ],
        "styles": [
          "apps/macro-workspace/src/styles.css",
          "apps/macro-workspace/src/openfin.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4202
      },
      "configurations": {
        "production": {
          "buildTarget": "macro-workspace:build:production"
        },
        "development": {
          "buildTarget": "macro-workspace:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "macro-workspace:build"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "client": {
      "executor": "@nx/workspace:run-commands",
      "options": {
        "command": "node apps/macro-workspace/launch.mjs http://localhost:4202/manifest.fin.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "macro-workspace:build",
        "port": 4202,
        "staticFilePath": "dist/apps/macro-workspace/browser",
        "spa": true
      }
    }
  }
}
